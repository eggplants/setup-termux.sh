# ~/.zshrc — managed by mise dotfiles (~/.config/mise/dotfiles/zshrc)

_zplug="$HOME/.local/share/zsh/plugins"

# history
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt appendhistory incappendhistory histignoredups sharehistory

# options
setopt correct autocd nolistbeep aliasfuncdef
setopt extendedglob interactivecomments prompt_subst
unsetopt nomatch

# colors
export LSCOLORS=gxfxcxdxbxegedabagacag
export LS_COLORS='di=36;40:ln=35;40:so=32;40:pi=33;40:ex=31;40:bd=34;46:cd=34;43:su=30;41:sg=30;46:tw=30;42:ow=30;46'

# completion
fpath+=("$_zplug/zsh-completions/src")
autoload -U compinit && compinit -u
zstyle ':completion:*' menu select
zstyle ':completion:*:default' list-colors "${(s.:.)LS_COLORS}"

# aliases
alias ll='ls -lGF --color=auto'
alias ls='ls -GF --color=auto'
alias mb='mise bootstrap'

bindkey '^[[A' up-line-or-search
bindkey '^[[B' down-line-or-search

# mise
command -v mise >/dev/null && eval "$(mise activate zsh)"

# GPG SSH agent
unset SSH_AGENT_PID
if [ "${gnupg_SSH_AUTH_SOCK_by:-0}" -ne $$ ]; then
  export SSH_AUTH_SOCK="$(gpgconf --list-dirs agent-ssh-socket)"
fi
export GPG_TTY=$(tty)
gpg-connect-agent updatestartuptty /bye >/dev/null

# plugins (cloned by [bootstrap.repos])
if [[ -d "$_zplug/pure" ]]; then
  fpath+=("$_zplug/pure")
  autoload -U promptinit && promptinit && prompt pure
fi
for _p in zsh-autosuggestions history-search-multi-word fast-syntax-highlighting; do
  if [[ -r "$_zplug/$_p/$_p.plugin.zsh" ]]; then
    source "$_zplug/$_p/$_p.plugin.zsh"
  elif [[ -r "$_zplug/$_p/$_p.zsh" ]]; then
    source "$_zplug/$_p/$_p.zsh"
  fi
done
unset _zplug _p
